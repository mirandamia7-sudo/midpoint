{
  "name": "midpoint",
  "private": true,
  "description": "Midpoint: a peer-to-peer market for stablecoins against local money, with a public API",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "dev:stack": "node scripts/dev-stack.ts",
    "hosted": "node scripts/hosted-stack.ts",
    "dev:simulate": "npm run dev:simulate-transfer -w @midpoint/api --"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "tmp": "0.2.7",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
